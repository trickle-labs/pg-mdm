# syntax=docker/dockerfile:1
ARG POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:efef99e1558f86089bc84bece29208c0777a185ff717ec7fa288a652ce2d0adf

FROM ${POSTGRES_IMAGE} AS build_tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang curl git libclang-dev libssl-dev pkg-config postgresql-server-dev-18 ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.98.0
ENV PATH=/root/.cargo/bin:$PATH
RUN --mount=type=cache,target=/root/.cargo/registry \
    cargo install --locked cargo-pgrx --version 0.18.0 \
    && cargo pgrx init --pg18 /usr/bin/pg_config

FROM build_tools AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock pg_mdm.control ./
COPY .cargo/ .cargo/
COPY src/ src/
COPY contracts/ contracts/
COPY tests/ tests/
COPY scripts/ scripts/
COPY sql/ sql/
COPY justfile ./
# Branch changes can leave source mtimes older than the shared target cache.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/build/target \
    rm -rf target/release/pg_mdm-pg18 \
    && cargo clean --release -p pg_mdm \
    && cargo pgrx package --pg-config /usr/bin/pg_config \
    && mkdir -p /package \
    && cp -R target/release/pg_mdm-pg18/. /package/ \
    && find /package -type f -print0 | sort -z | xargs -0 sha256sum > /tmp/pg_mdm-package-manifest.sha256

FROM build_tools AS pg_trickle_release
ARG PG_TRICKLE_REVISION=d8bb8eb5d45c5c9982e173e88914037433a1ee05
ARG PG_TRICKLE_URL=https://github.com/trickle-labs/pg-trickle.git
ARG PG_TRICKLE_SHA256=b8d4c59ca3770c305659255e09adde303b4d220228392c415ae363aa7be0a2da
# GitHub's default archive excludes the lockfile, benches, and build generator.
RUN git init /pg_trickle_source \
    && cd /pg_trickle_source \
    && git fetch --depth=1 "$PG_TRICKLE_URL" "$PG_TRICKLE_REVISION" \
    && git checkout --detach "$PG_TRICKLE_REVISION" \
    && printf '* -export-ignore\n' > .git/info/attributes \
    && git archive --format=tar HEAD -o /tmp/pg_trickle.tar \
    && echo "$PG_TRICKLE_SHA256  /tmp/pg_trickle.tar" | sha256sum -c -
WORKDIR /pg_trickle_source
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/pg_trickle_source/target \
    CARGO_BUILD_JOBS=2 cargo pgrx package --pg-config /usr/bin/pg_config --out-dir /pg_trickle_package \
    && git diff --exit-code -- Cargo.lock \
    && cp /pg_trickle_package/usr/lib/postgresql/18/lib/pg_trickle.so /usr/lib/postgresql/18/lib/ \
    && cp -R /pg_trickle_package/usr/share/postgresql/18/extension/. /usr/share/postgresql/18/extension/

FROM builder AS tester
COPY --from=pg_trickle_release /usr/lib/postgresql/18/lib/pg_trickle.so /usr/lib/postgresql/18/lib/
COPY --from=pg_trickle_release /usr/share/postgresql/18/extension/pg_trickle* /usr/share/postgresql/18/extension/
RUN chmod 0755 /root \
    && chown -R postgres:postgres \
        /build /root/.cargo /root/.pgrx /root/.rustup \
        /usr/lib/postgresql/18/lib /usr/share/postgresql/18/extension
ENV CARGO_HOME=/root/.cargo
ENV PGRX_HOME=/root/.pgrx
ENV RUSTUP_HOME=/root/.rustup
ENV USER=postgres
USER postgres

FROM ${POSTGRES_IMAGE}
COPY --from=pg_trickle_release /usr/lib/postgresql/18/lib/pg_trickle.so /usr/lib/postgresql/18/lib/
COPY --from=pg_trickle_release /usr/share/postgresql/18/extension/pg_trickle* /usr/share/postgresql/18/extension/
COPY --from=builder /package/usr/lib/postgresql/18/lib/ /usr/lib/postgresql/18/lib/
COPY --from=builder /package/usr/share/postgresql/18/extension/ /usr/share/postgresql/18/extension/
COPY --from=builder /tmp/pg_mdm-package-manifest.sha256 /evidence/pg_mdm-package-manifest.sha256
COPY sql/archive/pg_mdm--0.1.0.sql sql/archive/pg_mdm--0.2.0.sql /usr/share/postgresql/18/extension/
COPY tests/e2e.sql /tests/e2e.sql
COPY tests/e2e_policy.sql /tests/e2e_policy.sql
COPY tests/source_sync.sql /tests/source_sync.sql
COPY tests/scoped_state.sql /tests/scoped_state.sql
COPY tests/incremental_qualification.sql /tests/incremental_qualification.sql
COPY tests/operating_envelope.sql /tests/operating_envelope.sql
COPY tests/restore.sql /tests/restore.sql
COPY sql/configure_helper.sql /sql/configure_helper.sql
RUN echo "shared_preload_libraries = 'pg_trickle'" >> /usr/share/postgresql/postgresql.conf.sample \
    && echo "pg_trickle.enable_output_delta_qualification = on" >> /usr/share/postgresql/postgresql.conf.sample
USER postgres
ARG PG_MDM_SOURCE_REVISION=unknown
ARG PG_MDM_CANDIDATE_KEY=unknown
LABEL pg_mdm.source_revision=${PG_MDM_SOURCE_REVISION}
LABEL pg_mdm.candidate_key=${PG_MDM_CANDIDATE_KEY}
